# Salin ke .env.production (JANGAN di-commit, `chmod 600 .env.production`), lalu jalankan compose dengan
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# DATABASE_URL tiap service dibentuk otomatis oleh compose dari POSTGRES_*. Password: huruf & angka saja, panjang
# (min. 24 karakter), karena ikut masuk URL koneksi.

# Database — role minimum (hardening Tahap 4, docs/08-INVENTARIS-DATA.md)
# Pemilik: hanya dipakai migrasi & seed (service migrate).
POSTGRES_USER="oa"
POSTGRES_PASSWORD="ganti-password-db"
POSTGRES_DB="office_automation"
# Role oa_app: aplikasi & worker (baca/tulis isi tabel saja).
POSTGRES_APP_PASSWORD="ganti-password-app"
# Role oa_backup: backup harian (hanya baca).
POSTGRES_BACKUP_PASSWORD="ganti-password-backup"

# Enkripsi data pribadi (hardening Tahap 4) — buat dengan `npm run keys:generate`, JANGAN memakai kunci dev.
# Kunci hilang = data terenkripsi hilang. Salinannya dititipkan OTOMATIS (service migrate) dalam keadaan terkunci kata
# sandi pemulihan para pemegang kunci di bawah. Server baru yang dipulihkan dari backup: biarkan dua baris ini apa adanya,
# scripts/restore.sh mengisinya dari titipan.
# Rotasi: kunci baru di DEPAN (mis. "v2:…,v1:…"), kunci lama jangan dihapus (audit log & backup lama memakainya).
DATA_ENCRYPTION_KEYS="v1:ganti-dengan-hasil-keys-generate"
DATA_INDEX_KEY="ganti-dengan-hasil-keys-generate"

# Pemegang kunci pemulihan (docs/08-INVENTARIS-DATA.md §4): email akun aplikasi — HARUS sama persis dengan email login
# Pak Rudy & Pak Leonard di aplikasi (cek di Setting → User), pisahkan koma. Hanya mereka yang melihat
# Setting → Kunci Pemulihan; backup & titipan kunci data dikunci untuk kata sandi pemulihan mereka. Minimal 2 orang yang
# sudah membuat kata sandi pemulihan, kalau tidak backup ditolak. Pak Rudy & Pak Leonard (Direktur); Divisi IT: belum
# diputuskan (catatan 2026-10-20) — bila diputuskan, tambahkan emailnya di sini.
RECOVERY_KEY_HOLDERS="rudy@artha-mitra.co.id,leonard@artha-mitra.co.id"

# Pintu masuk — reverse proxy nginx (hardening Tahap 3)
# Domain aplikasi; AUTH_URL & APP_URL di bawah harus https://<APP_DOMAIN>.
APP_DOMAIN="oa.artha-mitra.co.id"
# IP LAN server tempat port 80/443 dibuka (jangan 0.0.0.0). Uji lokal: 127.0.0.1
BIND_IP="192.168.10.10"
# Jaringan yang boleh membuka aplikasi, pisahkan dengan koma (mis. jaringan karyawan + VPN). Dari IT kantor.
ALLOWED_SUBNETS="192.168.20.0/24"
# Lokasi sertifikat di container. Default: deploy/certs/fullchain.pem & privkey.pem.
# Let's Encrypt: /etc/letsencrypt/live/<APP_DOMAIN>/fullchain.pem & privkey.pem
# TLS_CERT_PATH="/etc/nginx/certs/fullchain.pem"
# TLS_KEY_PATH="/etc/nginx/certs/privkey.pem"

# Jadwal backup harian (NF-06)
BACKUP_TIME="01:00"
BACKUP_KEEP_DAYS="14"
# Backup dikunci untuk gembok para pemegang kunci (RECOVERY_KEY_HOLDERS di atas) — tidak ada kunci yang perlu diisi di sini.

# Salinan backup ke LUAR server (scripts/backup-offsite.sh, dijalankan cron di host — docs/07-DEPLOYMENT.md §7).
# Isi salah satu atau keduanya. OFFSITE_DIR = folder NAS yang di-mount (wajib berisi file penanda .oa-offsite);
# OFFSITE_RCLONE = remote rclone (mis. b2:oa-backup). OFFSITE_PING_URL opsional (monitor push Uptime Kuma / healthchecks).
OFFSITE_DIR="/mnt/nas-oa/office-automation"
OFFSITE_RCLONE=""
OFFSITE_KEEP_DAYS="90"
OFFSITE_PING_URL=""

# Auth.js — generate: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak-panjang"
AUTH_URL="https://oa.artha-mitra.co.id"
AUTH_TRUST_HOST="true"

# Content Security Policy: "enforce" (blokir; default produksi) atau "report-only" (uji coba)
CSP_MODE="enforce"

# URL publik aplikasi (link di email)
APP_URL="https://oa.artha-mitra.co.id"

# SMTP produksi — WAJIB TLS (hardening Tahap 6): port 465 = TLS langsung, 587 = STARTTLS wajib. Server SMTP tanpa TLS
# atau dengan sertifikat tidak valid ditolak (email gagal & tercatat FAILED di EmailLog), bukan dikirim terbuka.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Office Automation <no-reply@artha-mitra.co.id>"

# File storage (volume "uploads" di compose)
STORAGE_DRIVER="local"
MAX_UPLOAD_MB="5"

# Seed deploy pertama (docker compose ... run --rm migrate npx prisma db seed)
SEED_PASSWORD="ganti-password-seed"
# Akun hasil seed wajib ganti password saat login pertama (hardening 2026-10)
SEED_MUST_CHANGE_PASSWORD="true"
