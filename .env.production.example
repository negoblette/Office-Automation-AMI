# Salin ke .env.production (JANGAN di-commit), lalu jalankan compose dengan
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# DATABASE_URL dibentuk otomatis oleh compose dari POSTGRES_*.

# Database
POSTGRES_USER="oa"
POSTGRES_PASSWORD="ganti-password-db"
POSTGRES_DB="office_automation"

# Port host aplikasi & jadwal backup harian (NF-06)
APP_PORT="3000"
BACKUP_TIME="01:00"
BACKUP_KEEP_DAYS="14"

# Auth.js — generate: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak-panjang"
AUTH_URL="https://oa.artha-mitra.co.id"
AUTH_TRUST_HOST="true"

# URL publik aplikasi (link di email)
APP_URL="https://oa.artha-mitra.co.id"

# SMTP produksi
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Office Automation <no-reply@artha-mitra.co.id>"

# File storage (volume "uploads" di compose)
STORAGE_DRIVER="local"
MAX_UPLOAD_MB="5"

# Seed deploy pertama (docker compose ... run --rm migrate npx prisma db seed)
SEED_PASSWORD="ganti-password-seed"
