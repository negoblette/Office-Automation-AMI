// =====================================================================
// Office Automation System — Prisma Schema (DRAFT v0.1)
// Prisma 7 · PostgreSQL
// Referensi: docs/02-TECH-SPEC.md
// Catatan:
//  - Semua nominal uang dalam IDR tanpa desimal -> BigInt.
//    Konversi ke number/string sebelum dikirim ke Client Component.
//  - Tanggal tanpa jam -> @db.Date. Zona waktu aplikasi: Asia/Jakarta.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL koneksi diatur di prisma.config.ts (Prisma 7)
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  ADMIN // lihat & kelola semua data + Setting
  STAFF // hanya data sendiri; divisi (Sales/Engineer/Umum) dari Employee.division
  APPROVER // seperti STAFF + menyetujui pengajuan yang ditugaskan (Fase 14, 2026-10-02)
}

enum EmployeeStatus {
  ACTIVE
  RESIGNED
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum FamilyRelation {
  SPOUSE
  CHILD
}

enum DocumentOwnerType {
  EMPLOYEE
  FAMILY
  CANDIDATE
}

enum DocumentType {
  KTP
  KK
  NPWP
  PAS_FOTO
  SIM
  BPJS_TK
  BPJS_KES
  IJAZAH_TRANSKRIP
  SKCK
  SURAT_NIKAH_CERAI
  KTP_PASANGAN
  AKTE_KELAHIRAN_ANAK
  OTHER
}

enum CertificateType {
  PROFESSIONAL
  IJAZAH
}

/// Jenjang pendidikan ijazah (2026-10-12).
enum EducationLevel {
  SMA_SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
}

enum AssetCategory {
  DEMO_UNIT
  BACKUP_UNIT
  INVENTORY
}

// 2026-10-12: Cash → PERSONAL (uang pribadi karyawan), Kartu Kredit → CORPORATE (dana/kartu perusahaan).
enum PaymentMethod {
  PERSONAL
  CORPORATE
}

enum ProjectType {
  RUNNING
  NEW_ACQUISITION
}

enum CandidateStatus {
  APPLIED
  INTERVIEW
  ACCEPTED
  REJECTED
}

/// Jenis cuti (2026-10-30). Tahunan memotong saldo; Kematian tidak; Melahirkan gratis 2 hari kerja (laki-laki) /
/// 90 hari kerja (perempuan), lebihnya memotong saldo. Approver bisa mengubah lewat `LeaveRequest.deductDays`.
enum LeaveType {
  ANNUAL // cuti tahunan
  MATERNITY // cuti melahirkan
  BEREAVEMENT // cuti kematian (keluarga meninggal)
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED // disiapkan; alur reject ditunda (OI-05)
}

enum ApprovalModule {
  REIMBURSE
  LEAVE
  HEALTH
  EXPENSE
  CERTIFICATE // verifikasi sertifikat (Fase 14, 2026-10-05)
  ATTENDANCE_APPEAL // appeal tidak hadir: sakit / kunjungan keluar (Fase 14)
  OVERTIME // sesi overtime engineer yang sudah di-finalize (2026-10-30, Ko Yosep)
  /// Hanya untuk memilih Approval Flow reimburse overtime (2026-10-30, Ci Ika); ApprovalRequest-nya tetap modul REIMBURSE.
  OVERTIME_REIMBURSE
  DEMO_LOAN // peminjaman unit demo / Product Trial Form (Fase 16, 2026-11-17, Ko Yosep)
  /// Perpanjangan jatuh tempo peminjaman (Tahap 16.4, 2026-11-18). Approval Flow-nya memakai flow DEMO_LOAN (tidak diatur
  /// terpisah di Setting); entityId = DemoLoanExtension.id.
  DEMO_LOAN_EXTENSION
  /// Verifikasi hasil Pengecekan Unit oleh engineer (2026-11-20, default Ko Yosep; Approval Flow sendiri). entityId =
  /// DemoLoan.id.
  DEMO_LOAN_RETURN
}

/// Jenis perubahan data karyawan yang menunggu persetujuan (2026-10-12).
enum AppealReason {
  SICK // sakit
  VISIT // kunjungan keluar
  OTHER // lainnya — keterangan wajib, tanpa lampiran (2026-10-30)
}

enum FlowScope {
  REGULAR
  FALLBACK // dipakai jika semua step ter-skip (kecuali flow autoApproveWhenSkipped)
}

enum StepStatus {
  WAITING
  PENDING
  APPROVED
  SKIPPED
  REJECTED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  lastLoginAt        DateTime?
  sessionVersion     Int       @default(0)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  // MFA / verifikasi dua langkah (hardening Tahap 5): kode 6 digit TOTP (Google/Microsoft Authenticator).
  // Wajib untuk Admin & Approver. Rahasia base32 disimpan terenkripsi (encryptText).
  mfaSecret          String? // aktif; null = MFA belum aktif
  mfaPendingSecret   String? // sedang didaftarkan, belum dikonfirmasi dengan kode
  mfaEnabledAt       DateTime?
  mfaLastStep        Int? // time-step TOTP terakhir yang diterima — kode yang sama tidak bisa dipakai dua kali
  /// Super admin (2026-10-30, admin.oa@arthamitra.co.id): bisa menyetujui semua pengajuan, membuka modul yang ditunda,
  /// dan tidak bisa diubah/dinonaktifkan Admin lain. Hanya diatur lewat migrasi/seed, tidak dari aplikasi.
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  approverOfSteps  ApprovalStepApprover[]
  approvalRequests ApprovalRequest[]      @relation("RequestRequester")
  actedSteps       ApprovalRequestStep[]  @relation("StepActor")
  auditLogs        AuditLog[]
  uploadedDocs     Document[]             @relation("DocUploader")
  attendanceFixes  Attendance[]           @relation("AttendanceCorrector")
  corrections      ApprovalCorrection[]   @relation("CorrectionEditor")
  leaveAdjustments LeaveAdjustment[]      @relation("LeaveAdjuster")
  mfaBackupCodes   MfaBackupCode[]
  uploads          UploadedFile[]
  recoveryKeys     RecoveryKey[]
  notificationDismissals NotificationDismissal[]
  demoLoansRequested     DemoLoan[]             @relation("DemoLoanRequester")
  demoLoansPrepared      DemoLoan[]             @relation("DemoLoanOperational")
  demoLoansReceived      DemoLoan[]             @relation("DemoLoanReceiver")
  demoLoansHafPrepared   DemoLoan[]             @relation("DemoLoanHafPreparer")
  demoLoansFollowedUp    DemoLoan[]             @relation("DemoLoanFollowUpResolver")
  goodsReceiptsPrepared  GoodsReceipt[]         @relation("GoodsReceiptPreparer")
  demoLoanExtensions     DemoLoanExtension[]
}

/// File yang di-upload lewat aplikasi (hardening Tahap 7): pengunggahnya — hanya dia yang boleh menautkan file ke data —
/// dan ukurannya untuk kuota upload. Baris tetap ada walau file yatimnya dihapus job `storage.orphan-purge`.
model UploadedFile {
  key        String   @id // nama file di storage (<uuid>.pdf)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@index([uploaderId, createdAt])
}

/// Kode cadangan MFA sekali pakai (hardening Tahap 5), untuk HP hilang. Hanya hash yang disimpan.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // SHA-256(userId:kode) — kode acak ±50 bit, tidak perlu hash lambat
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Kunci pemulihan pemegang kunci (Pak Rudy & Pak Leonard; daftar di env RECOVERY_KEY_HOLDERS) — docs/08-INVENTARIS-DATA.md
// §4–5. Kunci age pribadinya dikunci kata sandi pemulihan dan disimpan sebagai FILE di RECOVERY_DIR (ikut backup,
// sengaja tidak di database); di sini hanya kunci publiknya ("gembok" backup & titipan kunci data) dan riwayatnya.
model RecoveryKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  recipient  String // kunci publik age (age1…)
  createdAt  DateTime  @default(now())
  verifiedAt DateTime? // terakhir kata sandi pemulihan berhasil diuji
  revokedAt  DateTime? // diganti kunci baru → tidak dipakai lagi untuk backup baru

  @@index([userId])
}

// ---------------------------------------------------------------------
// KARYAWAN
// ---------------------------------------------------------------------

model Employee {
  id                String         @id @default(cuid())
  // Admin membuat record minimal (nama, email, divisi, jabatan, tgl masuk, role);
  // data diri lainnya dilengkapi staf sendiri, jadi boleh kosong dulu.
  // Kolom bertanda "terenkripsi" disimpan sebagai ciphertext AES-256-GCM (hardening Tahap 4,
  // lib/services/personal-data.ts) — jangan dibaca/ditulis langsung tanpa seal/open.
  employeeNo        String?        @unique // nomor induk karyawan internal
  nik               String? // KTP 16 digit, terenkripsi; keunikan lewat nikHash
  nikHash           String?        @unique // sidik jari NIK (HMAC-SHA256) untuk cek unik & pencarian
  kkNo              String? // terenkripsi
  fullName          String
  birthPlace        String?
  birthDate         String? // YYYY-MM-DD, terenkripsi
  gender            Gender?
  maritalStatus     MaritalStatus  @default(SINGLE)
  address           String?
  phone             String? // format +62..., terenkripsi
  email             String         @unique
  npwp              String? // 15/16 digit tanpa tanda baca, terenkripsi
  bpjsTkNo          String? // terenkripsi
  bpjsKesNo         String? // terenkripsi
  // Kontak darurat (Fase 14), diisi karyawan sendiri; terenkripsi.
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String? // format +62...
  division          String // kode Division (master, 2026-10-12)
  position          String // jabatan
  level             String? // level/grade
  status            EmployeeStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User?
  periods           EmploymentPeriod[]
  family            FamilyMember[]
  documents         Document[]
  certificates      Certificate[]
  assetAssignments  AssetAssignment[]
  assets            EmployeeAsset[]
  reimbursements    Reimbursement[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  healthPlafonds    HealthPlafond[]
  healthClaims      HealthClaim[]
  attendances       Attendance[]
  attendanceAppeals AttendanceAppeal[]
  overtimes         Overtime[]
  fromCandidate     Candidate?
  demoLoansAsPic     DemoLoan[]        @relation("DemoLoanPic")
  demoLoansAsSender  DemoLoan[]        @relation("DemoLoanItemSender")
  demoLoansAsCourier DemoLoan[]        @relation("DemoLoanCourier")
  goodsReceiptsAsPic GoodsReceipt[]    @relation("GoodsReceiptPic")
  goodsReceived      GoodsReceipt[]    @relation("GoodsReceiptReceiver")

  @@index([status, division])
}

model EmploymentPeriod {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  startDate  DateTime  @db.Date // tgl masuk
  endDate    DateTime? @db.Date // tgl keluar (null = masih aktif)
  endReason  String? // mis. "RESIGN"
  note       String?
  createdAt  DateTime  @default(now())

  @@index([employeeId, startDate])
}

model FamilyMember {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  relation   FamilyRelation
  fullName   String
  nik        String? // terenkripsi (hardening Tahap 4)
  birthDate  String? // YYYY-MM-DD, terenkripsi
  documents  Document[]
  createdAt  DateTime       @default(now())
  deletedAt  DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)
}

model Document {
  id             String            @id @default(cuid())
  ownerType      DocumentOwnerType
  employeeId     String?
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  familyMemberId String?
  familyMember   FamilyMember?     @relation(fields: [familyMemberId], references: [id])
  candidateId    String?
  candidate      Candidate?        @relation(fields: [candidateId], references: [id])
  docType        DocumentType
  fileKey        String // path/key di storage (nama UUID)
  fileName       String // nama asli
  mimeType       String
  sizeBytes      Int
  /// Masa berlaku dokumen (opsional, 2026-10-12): yang diisi ikut pengingat H-30 & notifikasi dashboard.
  validUntil     DateTime?         @db.Date
  uploadedById   String
  uploadedBy     User              @relation("DocUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime          @default(now())
  deletedAt      DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)

  @@index([employeeId, docType])
  @@index([candidateId])
}

model Certificate {
  id                 String          @id @default(cuid())
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id])
  type               CertificateType
  name               String
  issuer             String?
  number             String? // lama (diganti level / jenjang 2026-10-12)
  /// Profesional: level 1–3.
  level              Int?
  /// Ijazah: jenjang (SMA/SMK, D1–D4, S1–S3).
  degree             EducationLevel?
  startDate          DateTime        @db.Date // profesional: tanggal diambil; ijazah: tanggal mulai
  endDate            DateTime?       @db.Date // masa berlaku profesional; null = permanen / ijazah
  graduationDate     DateTime?       @db.Date // ijazah: tanggal lulus
  fileKey            String?
  /// Verifikasi Ci Ika (2026-10-12; sebelumnya Ko Yosep → Bu Ika). Nomor CRT/YYYY/MM/NNNN untuk approval.
  status             RequestStatus   @default(PENDING)
  verificationNumber String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)

  @@index([endDate])
}

// ---------------------------------------------------------------------
// INVENTORY / DEMO UNIT
// ---------------------------------------------------------------------

model Asset {
  id            String        @id @default(cuid())
  deviceName    String
  serialNo      String        @unique // uppercase
  category      AssetCategory
  supportStart  DateTime?     @db.Date
  supportEnd    DateTime?     @db.Date
  warrantyStart DateTime?     @db.Date
  warrantyEnd   DateTime?     @db.Date
  warrantyNote  String?
  notes         String?
  /// Kepemilikan (2026-11-17): unit yang dipinjamkan bisa milik AMI atau titipan principal / distributor.
  ownership     AssetOwnership @default(AMI)
  /// Nama principal / distributor (wajib bila bukan milik AMI).
  ownerName     String?
  /// Penerimaan barang (HAF) tempat unit principal / distributor ini masuk (2026-11-20). Kosong = milik AMI, atau unit
  /// titipan lama yang didaftarkan sebelum ada penerimaan barang. Kepemilikan unit hanya bisa diisi lewat penerimaan.
  receiptId     String?
  receipt       GoodsReceipt? @relation(fields: [receiptId], references: [id])
  /// Lokasi penyimpanan (2026-11-17): rak + posisi "A1" (huruf kolom + nomor baris). Satu posisi boleh banyak unit.
  rackId        String?
  rack          StorageRack?  @relation(fields: [rackId], references: [id])
  rackPosition  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignments AssetAssignment[]
  loanItems   DemoLoanItem[]
  deletedAt   DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)

  @@index([rackId, rackPosition])
  @@index([receiptId])
}

/// Penerimaan barang principal / distributor (2026-11-20) = satu Hardware Admission Form untuk barang yang masuk ke AMI
/// (HAF mendata semua barang masuk: unit pinjaman yang kembali & unit yang dipinjam AMI dari principal / distributor).
/// Satu kedatangan = satu HAF, boleh banyak unit; unit-unitnya langsung terdaftar di Daftar Unit dengan kepemilikan ini.
/// Dicatat HANYA oleh Operational. Nomor `NNN/AMI-HAF/<nama pemilik>/<tahun>` memakai counter HAF yang sama dengan
/// pengambilan peminjaman.
model GoodsReceipt {
  id           String         @id @default(cuid())
  hafNumber    String         @unique
  /// PRINCIPAL / DISTRIBUTOR (bukan AMI) + namanya — "From" di HAF.
  ownership    AssetOwnership
  ownerName    String
  /// Kontak di principal / distributor ("up:" di HAF, wajib).
  contactName  String
  /// Tanggal barang diterima ("Date" di HAF).
  receivedDate DateTime       @db.Date
  /// PIC dari AMI (karyawan aktif Engineer / Sales) — kolom "PIC" di HAF.
  picId        String
  pic          Employee       @relation("GoodsReceiptPic", fields: [picId], references: [id])
  /// Pengirim dari principal / distributor ("Returned By", opsional) & karyawan AMI penerima ("Received By").
  senderName   String?
  receiverId   String
  receiver     Employee       @relation("GoodsReceiptReceiver", fields: [receiverId], references: [id])
  /// Keperluan / catatan (Remarks di HAF).
  purpose      String?
  /// Operational yang mencatat ("Prepared By").
  preparedById String
  preparedBy   User           @relation("GoodsReceiptPreparer", fields: [preparedById], references: [id])
  createdAt    DateTime       @default(now())

  assets Asset[]

  @@index([receivedDate])
}

/// Rak penyimpanan unit Inventory (2026-11-17), diatur Admin di Setting → Inventaris & Rak. Posisi di rak = huruf kolom
/// (A, B, …) + nomor baris (1, 2, …), mis. "A1". Hapus = soft delete; nama yang pernah dihapus dipulihkan bila ditambah lagi.
model StorageRack {
  id        String    @id @default(cuid())
  name      String    @unique
  columns   Int // jumlah kolom (1–26) → huruf A..Z
  rows      Int // jumlah baris (1–50)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assets            Asset[]
  loanItems         DemoLoanItem[] @relation("DemoLoanItemRack")
  returnedLoanItems DemoLoanItem[] @relation("DemoLoanItemReturnRack")
}

/// Status peminjaman unit ke perusahaan lain lewat Product Trial Form (Fase 16, 2026-11-17).
enum DemoLoanStatus {
  PENDING // diajukan Engineer/Sales, menunggu approval (Approval Flow modul DEMO_LOAN, Ko Yosep)
  APPROVED // disetujui → masuk antrian Operational (Devi): siapkan barang & cetak form
  REJECTED // ditolak approver (alasan wajib) → pemohon bisa revisi lalu ajukan ulang
  CANCELLED // dibatalkan pemohon sebelum disetujui
  ON_LOAN // barang sudah diantar ke peminjam (Tahap 16.3)
  RETURNED // barang kembali & sudah dicek Operational (Tahap 16.5)
  PICKUP // pengambilan dijadwalkan Operational: HAF terbit & dibawa kurir AMI, menunggu Pengecekan Unit (2026-11-19)
  FOLLOW_UP // sudah dicek tapi ada unit Rusak / Tidak lengkap → ditindaklanjuti PIC & Operational, ditutup Operational (2026-11-20)
  RETURN_REVIEW // Pengecekan Unit tersimpan, menunggu verifikasi engineer (approval DEMO_LOAN_RETURN, Ko Yosep) (2026-11-20)
}

/// Kegunaan peminjaman (2026-11-17).
enum LoanPurpose {
  BACKUP_UNIT // pengganti sementara unit customer yang bermasalah
  POC // unit untuk pengujian (proof of concept) di customer
  OTHER // lainnya — detail wajib di DemoLoan.purposeDetail
}

/// Kondisi unit saat dicek Operational ketika kembali dari peminjam (Tahap 16.5, 2026-11-18).
enum ReturnCondition {
  GOOD // baik
  DAMAGED // rusak
  INCOMPLETE // tidak lengkap (kelengkapan kurang)
}

/// Kepemilikan unit Inventory (2026-11-17): milik AMI, atau titipan principal / distributor (nama di Asset.ownerName).
enum AssetOwnership {
  AMI
  PRINCIPAL
  DISTRIBUTOR
}

/// Peminjaman unit demo ke perusahaan lain (Fase 16, 2026-11-17) = satu Product Trial Form. Unit yang sedang ada di
/// peminjaman PENDING / APPROVED / ON_LOAN / PICKUP tidak bisa diajukan di peminjaman lain (dikunci di
/// services/demo-loan.ts). Nomor `NNN/AMI-PTF/<pemilik unit>/<tahun>` terbit saat diajukan, urut ulang tiap tahun.
/// Persetujuan lewat approval engine (modul DEMO_LOAN); keputusan & alasan tolak ada di ApprovalRequest.
model DemoLoan {
  id            String           @id @default(cuid())
  number        String           @unique
  status        DemoLoanStatus   @default(PENDING)
  purpose       LoanPurpose
  /// Detail kegunaan bila `purpose` = OTHER (wajib), selain itu kosong.
  purposeDetail String?
  /// Pemohon = "Prepared By" di form.
  requesterId   String
  requester     User             @relation("DemoLoanRequester", fields: [requesterId], references: [id])
  /// PIC dari AMI (2026-11-19, dulu "Sales Person"): karyawan aktif divisi Engineer / Sales — kolom "PIC" di form cetak.
  picId         String
  pic           Employee         @relation("DemoLoanPic", fields: [picId], references: [id])
  /// Pemilik unit (2026-11-19): "AMI" atau nama principal / distributor — segmen ketiga nomor PTF & HAF. Satu form = satu
  /// pemilik (dicek saat diajukan / diubah).
  unitOwner     String
  /// Peminjam: dipilih dari master Customer (customerId terisi) atau diketik bebas (hanya borrowerName).
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  borrowerName  String
  /// Kontak di perusahaan peminjam ("up:" di form) & emailnya (2026-11-19, dulu "PIC"). TIDAK dikirimi email
  /// (keputusan user 2026-11-17: pengingat hanya ke pemohon & Operational).
  contactName   String
  contactEmail  String
  /// Jangka pinjam = tanggal mulai s/d tanggal selesai (keduanya diisi pengaju, inklusif). Lamanya (tahun / bulan / hari)
  /// dihitung dari kedua tanggal ini (lib/demo-loan.ts#loanSpan), tidak disimpan.
  startDate     DateTime         @db.Date
  /// Tanggal selesai = hari terakhir peminjaman = jatuh tempo.
  dueDate       DateTime         @db.Date
  remarks       String?
  submittedAt   DateTime
  /// Disetujui final (approval engine) → masuk antrian Operational.
  approvedAt    DateTime?
  /// Pengantar barang ("Item Sender" di form), dipilih Operational saat menyiapkan barang.
  itemSenderId  String?
  itemSender    Employee?        @relation("DemoLoanItemSender", fields: [itemSenderId], references: [id])
  /// Operational yang menyiapkan (memilih Item Sender) — "Operational" di form cetak (Tahap 16.3).
  operationalId String?
  operational   User?            @relation("DemoLoanOperational", fields: [operationalId], references: [id])
  /// Barang diantar ke peminjam (Tahap 16.3): tanggal & nama penerima ("Received By").
  deliveredAt   DateTime?        @db.Date
  receivedByName String?
  /// Pengambilan (2026-11-19): Operational menjadwalkan → nomor Hardware Admission Form terbit, HAF dibawa kurir AMI ke
  /// peminjam. Tanggal pengambilan ("Date" di HAF), kurir ("Received By"), Operational yang menerbitkan ("Prepared By").
  pickupDate      DateTime?      @db.Date
  courierId       String?
  courier         Employee?      @relation("DemoLoanCourier", fields: [courierId], references: [id])
  hafPreparedById String?
  hafPreparedBy   User?          @relation("DemoLoanHafPreparer", fields: [hafPreparedById], references: [id])
  /// `NNN/AMI-HAF/<pemilik unit>/<tahun>`, urut per tahun. Terbit saat pengambilan dijadwalkan; tetap melekat bila
  /// pengambilan dibatalkan lalu dijadwalkan lagi.
  hafNumber      String?         @unique
  /// Barang tiba di AMI & sudah dicek Operational (Pengecekan Unit): tanggal tiba, yang menyerahkan di peminjam
  /// ("Returned By" di HAF, opsional), Operational yang mengecek, catatan umum.
  returnedAt     DateTime?       @db.Date
  returnedByName String?
  receivedById   String?
  receivedBy     User?           @relation("DemoLoanReceiver", fields: [receivedById], references: [id])
  returnNote     String?
  /// Tindak lanjut (2026-11-20): pengecekan menemukan unit Rusak / Tidak lengkap → status FOLLOW_UP sampai Operational
  /// menyelesaikannya (catatan wajib, hasil per unit di DemoLoanItem.resolvedCondition). `followUpRemindedAt` = email
  /// tindak lanjut terakhir ke PIC & Operational (pengingat diulang tiap 7 hari; kosong = belum pernah dikirim).
  followUpRemindedAt   DateTime?
  followUpNote         String?
  followUpResolvedAt   DateTime?
  followUpResolvedById String?
  followUpResolvedBy   User?     @relation("DemoLoanFollowUpResolver", fields: [followUpResolvedById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items      DemoLoanItem[]
  extensions DemoLoanExtension[]
  reminders  DemoLoanReminder[]

  @@index([status, dueDate])
  @@index([requesterId, status])
}

/// Status pengajuan perpanjangan jatuh tempo (Tahap 16.4).
enum DemoLoanExtensionStatus {
  PENDING // menunggu approval (Approval Flow modul DEMO_LOAN — Ko Yosep)
  APPROVED // disetujui → DemoLoan.dueDate = newDueDate
  REJECTED // ditolak approver (alasan di ApprovalRequestStep.note)
  CANCELLED // dibatalkan pemohon, atau pengambilan barang keburu dijadwalkan sebelum diputuskan
}

/// Perpanjangan jatuh tempo peminjaman yang sedang Dipinjam (Tahap 16.4, 2026-11-18). Diajukan pemohon / Operational,
/// disetujui lewat approval engine (modul DEMO_LOAN_EXTENSION, memakai Approval Flow DEMO_LOAN). Paling banyak satu yang
/// PENDING per peminjaman (dijaga service dengan mengunci baris DemoLoan). Riwayat perpanjangan tetap tersimpan.
model DemoLoanExtension {
  id              String                  @id @default(cuid())
  loanId          String
  loan            DemoLoan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User                    @relation(fields: [requesterId], references: [id])
  /// Jatuh tempo saat diajukan & yang diminta (keduanya hari terakhir pinjam, inklusif).
  previousDueDate DateTime                @db.Date
  newDueDate      DateTime                @db.Date
  reason          String
  status          DemoLoanExtensionStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  decidedAt       DateTime?

  @@index([loanId, status])
}

/// Jejak email pengingat jatuh tempo yang sudah dibuat (Tahap 16.4). `stage` = hari relatif terhadap jatuh tempo:
/// -7 (7 hari lagi), -1 (besok / hari ini), 1 (terlambat), lalu 8, 15, … (masih terlambat, tiap 7 hari). Satu baris per
/// peminjaman per jatuh tempo per tahap → tidak terkirim dua kali; jatuh tempo diperpanjang = tanggal baru = mulai lagi.
model DemoLoanReminder {
  id        String   @id @default(cuid())
  loanId    String
  loan      DemoLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueDate   DateTime @db.Date
  stage     Int
  createdAt DateTime @default(now())

  @@unique([loanId, dueDate, stage])
}

/// Unit di dalam peminjaman. Nama, SN, dan posisi rak disalin saat diajukan / disetujui supaya form cetak & riwayat
/// tidak berubah walau data unit diubah belakangan.
model DemoLoanItem {
  id           String       @id @default(cuid())
  loanId       String
  loan         DemoLoan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset        @relation(fields: [assetId], references: [id])
  deviceName   String
  serialNo     String
  rackId       String?
  rack         StorageRack? @relation("DemoLoanItemRack", fields: [rackId], references: [id])
  rackPosition String?
  /// Hasil cek saat kembali (Tahap 16.5): kondisi, catatan, dan posisi rak tempat unit ditaruh kembali.
  returnCondition    ReturnCondition?
  returnNote         String?
  returnRackId       String?
  returnRack         StorageRack?     @relation("DemoLoanItemReturnRack", fields: [returnRackId], references: [id])
  returnRackPosition String?
  /// Kondisi akhir setelah tindak lanjut (2026-11-20): GOOD = sudah lengkap / diperbaiki, sama dengan returnCondition =
  /// tetap rusak / tidak lengkap. Kosong = tidak perlu / belum ditindaklanjuti. returnCondition tetap = kondisi saat tiba.
  resolvedCondition  ReturnCondition?

  @@unique([loanId, assetId])
  @@index([assetId])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  assignedAt DateTime  @db.Date
  returnedAt DateTime? @db.Date
  note       String?

  @@index([assetId, returnedAt])
}

// ---------------------------------------------------------------------
// CUSTOMER & PROJECT
// ---------------------------------------------------------------------

model Customer {
  id        String    @id @default(cuid())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())

  reimbursementItems ReimbursementItem[]
  overtimes          Overtime[]
  demoLoans          DemoLoan[]
  deletedAt          DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)
}

model Project {
  id         String      @id @default(cuid())
  /// ID project (Fase 14), tampil sebagai "ID - Nama Project".
  code       String?     @unique
  name       String
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       ProjectType
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  reimbursementItems ReimbursementItem[]
  expenses           ProjectExpense[]
  overtimes          Overtime[]

  @@unique([customerId, name])
}

model ProjectExpense {
  id            String        @id @default(cuid())
  number        String        @unique
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id])
  date          DateTime      @db.Date
  description   String
  paymentMethod PaymentMethod
  amount        BigInt
  status        RequestStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime      @default(now())
}

// TODO(OI-06): detail field revenue belum ditentukan
// ---------------------------------------------------------------------
// REIMBURSEMENT
// ---------------------------------------------------------------------

model ReimburseType {
  id        String   @id @default(cuid())
  code      String   @unique // ENTERTAINMENT, MEALS, GIFT, ACCOMMODATION, TRANSPORT, ALLOWANCE
  name      String
  divisions String[] // kode divisi yang boleh memakai tipe ini (dropdown difilter dengan `has`)
  isActive  Boolean  @default(true)

  items ReimbursementItem[]
}

model Reimbursement {
  id             String        @id @default(cuid())
  number         String        @unique // RMB/YYYY/MM/NNNN
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  division       String // kode divisi, snapshot saat submit
  status         RequestStatus @default(DRAFT)
  totalPersonal  BigInt        @default(0)
  totalCorporate BigInt        @default(0)
  total          BigInt        @default(0)
  note           String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// Draft belum lengkap (2026-11-04): isian form apa adanya; `items` kosong sampai lengkap. null = draft/pengajuan normal.
  draftForm Json?
  items     ReimbursementItem[]
  deletedAt DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)

  @@index([employeeId, status])
}

model ReimbursementItem {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  /// Prospek "New Acquisition" tanpa project (Fase 14, 2026-10-05).
  newAcquisition  Boolean       @default(false)
  activity        String // Activities
  participants    String // Names – Position (multi-baris)
  location        String
  typeId          String
  type            ReimburseType @relation(fields: [typeId], references: [id])
  hasReceipt      Boolean
  paymentMethod   PaymentMethod
  amount          BigInt
  /// Baris dari sesi overtime (2026-10-30): nominal diisi approver (Ci Ika); satu overtime hanya bisa di-reimburse sekali.
  overtimeId      String?       @unique
  overtime        Overtime?     @relation(fields: [overtimeId], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------------
// CUTI
// ---------------------------------------------------------------------

model LeavePolicy {
  id       String @id @default(cuid())
  minYears Int // masa kerja (tahun penuh) minimal, inklusif
  maxYears Int? // inklusif; null = tanpa batas atas
  days     Int
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  periodStart DateTime @db.Date // 1 Jan tahun cuti (atau tanggal masuk/rehire di tahun itu) — periode = tahun kalender
  periodEnd   DateTime @db.Date
  entitlement Int // jatah dari LeavePolicy
  carriedOver Int      @default(0) // maks 3 (AppSetting leave.maxCarryOver)
  used        Int      @default(0)
  /// Total penyesuaian (Fase 14): + pemutihan/penambahan Admin, − potong cuti karena tidak hadir.
  adjustment  Int      @default(0)
  createdAt   DateTime @default(now())

  adjustments LeaveAdjustment[]

  @@unique([employeeId, periodStart])
}

// Riwayat penyesuaian saldo cuti (Fase 14). MANUAL = Admin (pemutihan / koreksi, alasan wajib);
// ABSENCE = potong otomatis 1 hari karena tidak hadir tanpa appeal (14.7, unik per tanggal).
model LeaveAdjustment {
  id             String       @id @default(cuid())
  balanceId      String
  balance        LeaveBalance @relation(fields: [balanceId], references: [id])
  employeeId     String
  days           Int
  reason         String
  source         String // MANUAL | ABSENCE
  attendanceDate DateTime?    @db.Date
  createdById    String?
  createdBy      User?        @relation("LeaveAdjuster", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
}

model LeaveRequest {
  id            String        @id @default(cuid())
  number        String        @unique // LV/YYYY/MM/NNNN
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  workingDays   Int // tanpa Sabtu/Minggu/Holiday
  reason        String
  type          LeaveType     @default(ANNUAL)
  /// Hari kerja yang dipotong dari saldo saat APPROVED final (0..workingDays). Awal menurut jenis cuti & jenis kelamin
  /// (`defaultDeductDays`); approver bisa mengubah saat menyetujui.
  deductDays    Int
  status        RequestStatus @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, status])
}

model Holiday {
  id            String        @id @default(cuid())
  date          DateTime      @unique @db.Date
  name          String
  isNational    Boolean       @default(true) // false = tambahan manual
  deletedAt     DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)
  /// Asal (2026-11-18): MANUAL = diisi / diimpor Admin (tidak pernah diubah sinkronisasi); SYNC = dari kalender Google
  /// "Hari Libur di Indonesia" — boleh ditambah, diganti nama, atau dihapus sinkronisasi mengikuti sumbernya.
  source        HolidaySource @default(MANUAL)
  /// Dihapus oleh sinkronisasi (sumber tidak lagi mencantumkannya) → boleh dipulihkan sinkronisasi bila muncul lagi.
  /// Hapus oleh Admin tetap false → tidak pernah dimunculkan lagi oleh sinkronisasi.
  removedBySync Boolean       @default(false)
}

enum HolidaySource {
  MANUAL
  SYNC
}

/// Jenis perubahan libur dari sinkronisasi (2026-11-18).
enum HolidayChangeKind {
  ADD // tanggal baru di sumber
  REMOVE // tanggal tidak ada lagi di sumber (dipindah / dibatalkan)
  RENAME // nama berubah (mis. "(belum pasti)" hilang setelah SKB final)
}

/// Perubahan yang terdeteksi tapi belum diterapkan: diterapkan bila masih sama setelah ≥ 20 jam (cek harian berikutnya);
/// hilang dari sumber sebelum itu → dibatalkan. Satu baris per jenis + tanggal.
model HolidayPendingChange {
  id           String            @id @default(cuid())
  kind         HolidayChangeKind
  date         DateTime          @db.Date
  name         String
  previousName String?
  firstSeenAt  DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())

  @@unique([kind, date])
}

/// Riwayat perubahan libur yang diterapkan sinkronisasi — dasar notifikasi ke penerima (HR & Direktur) beserta pengajuan
/// cuti yang hari kerjanya ikut berubah (saldo TIDAK dikoreksi otomatis). Satu `runId` = satu kali sinkronisasi.
model HolidayChange {
  id               String            @id @default(cuid())
  runId            String
  kind             HolidayChangeKind
  date             DateTime          @db.Date
  name             String
  previousName     String?
  affectedLeaveIds String[]
  appliedAt        DateTime          @default(now())

  @@index([appliedAt])
  @@index([runId])
}

// ---------------------------------------------------------------------
// KESEHATAN
// ---------------------------------------------------------------------

model HealthCategory {
  id        String  @id @default(cuid())
  name      String  @unique // Rawat jalan dokter, Obat-obatan, Vitamin, Kacamata
  isActive  Boolean @default(true)
  sortOrder Int     @default(100) // urutan di dropdown (2026-10-16); kategori baru di akhir, lalu A-Z

  claims     HealthClaim[]
  claimItems HealthClaimItem[]
}

model HealthPlafond {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  year         Int
  annualAmount BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, year])
}

model HealthClaim {
  id          String         @id @default(cuid())
  number      String         @unique // HC/YYYY/MM/NNNN
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  /// Kategori baris pertama (rincian per baris di `items`, 2026-11-06).
  categoryId  String
  category    HealthCategory @relation(fields: [categoryId], references: [id])
  /// Tanggal baris paling awal; tahunnya = tahun plafon (semua baris wajib di tahun yang sama).
  claimDate   DateTime       @db.Date
  /// Total semua baris.
  amount      BigInt
  note        String?
  status      RequestStatus  @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())

  items          HealthClaimItem[]
  payouts        HealthPayout[]
  /// Nominal disetujui approver (≤ nominal diajukan `amount`); null selama belum disetujui.
  approvedAmount BigInt?

  @@index([employeeId, status])
}

/// Baris klaim kesehatan (2026-11-06): satu klaim bisa berisi beberapa baris, seperti reimburse tapi tanpa kunjungan.
model HealthClaimItem {
  id         String         @id @default(cuid())
  claimId    String
  claim      HealthClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  categoryId String
  category   HealthCategory @relation(fields: [categoryId], references: [id])
  date       DateTime       @db.Date
  amount     BigInt
  note       String?

  @@index([claimId])
}

model HealthPayout {
  id          String      @id @default(cuid())
  claimId     String
  claim       HealthClaim @relation(fields: [claimId], references: [id])
  employeeId  String // denormalisasi untuk hitung pemakaian per bulan
  periodMonth DateTime    @db.Date // tanggal 1 bulan pembayaran
  amount      BigInt
  paidAt      DateTime?

  @@index([employeeId, periodMonth])
}

// ---------------------------------------------------------------------
// KANDIDAT
// ---------------------------------------------------------------------

model Candidate {
  id                  String          @id @default(cuid())
  fullName            String
  nik                 String? // terenkripsi (hardening Tahap 4)
  email               String
  phone               String? // terenkripsi
  appliedPosition     String
  status              CandidateStatus @default(APPLIED)
  notes               String?
  convertedEmployeeId String?         @unique
  convertedEmployee   Employee?       @relation(fields: [convertedEmployeeId], references: [id])
  documents           Document[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)
}

// ---------------------------------------------------------------------
// APPROVAL ENGINE
// ---------------------------------------------------------------------

model ApprovalFlow {
  id                     String             @id @default(cuid())
  module                 ApprovalModule?
  division               String? // kode divisi; null = berlaku untuk semua divisi
  scope                  FlowScope          @default(REGULAR)
  isActive               Boolean            @default(true)
  steps                  ApprovalFlowStep[]
  deletedAt              DateTime? // soft delete: data tidak dihapus permanen (NFR v1.14)
  /// Semua level terlewati (pemohon = approver-nya sendiri) → langsung disetujui, bukan ke Fallback.
  autoApproveWhenSkipped Boolean            @default(false)
}

model ApprovalFlowStep {
  id        String                 @id @default(cuid())
  flowId    String
  flow      ApprovalFlow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  level     Int // 1, 2, ...
  approvers ApprovalStepApprover[] // lebih dari satu = salah satu cukup

  @@unique([flowId, level])
}

model ApprovalStepApprover {
  stepId String
  step   ApprovalFlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id])

  @@id([stepId, userId])
}

// Instance approval per pengajuan (snapshot dari flow saat submit)
model ApprovalRequest {
  id           String         @id @default(cuid())
  module       ApprovalModule
  entityId     String // id Reimbursement / LeaveRequest / HealthClaim / ...
  entityNumber String // nomor dokumen, untuk tampilan & email
  requesterId  String
  requester    User           @relation("RequestRequester", fields: [requesterId], references: [id])
  status       RequestStatus  @default(PENDING)
  currentLevel Int?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  steps       ApprovalRequestStep[]
  corrections ApprovalCorrection[]

  @@unique([module, entityId])
  @@index([status])
}

model ApprovalRequestStep {
  id          String          @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level       Int
  approverIds String[] // snapshot user id approver
  status      StepStatus      @default(WAITING)
  actedById   String?
  actedBy     User?           @relation("StepActor", fields: [actedById], references: [id])
  actedAt     DateTime?
  note        String?

  @@unique([requestId, level])
}

// ---------------------------------------------------------------------
// SISTEM
// ---------------------------------------------------------------------

model NumberSequence {
  prefix    String // RMB, LV, HC, EXP, REV
  year      Int
  month     Int
  lastValue Int    @default(0)

  @@id([prefix, year, month])
}

model AppSetting {
  key       String   @id // mis. "leave.maxCarryOver" = 3
  value     Json
  updatedAt DateTime @updatedAt
}

/// Notifikasi lonceng yang sudah dibuka atau dihapus user (2026-11-16). Lonceng tetap dihitung dari data terkini
/// (services/notifications.ts); baris ini hanya menyembunyikan satu notifikasi untuk user itu. `key` memuat versi
/// notifikasi (id approval + waktu tolak, tanggal berakhir + tahap dokumen), jadi kejadian baru = kunci baru = muncul lagi.
/// Notifikasi antrian approval memakai `context` = id pengajuan yang menunggu saat dihapus; muncul lagi bila ada yang baru.
/// Tanpa data pribadi. Baris > 60 hari dibersihkan saat user menghapus notifikasi berikutnya.
model NotificationDismissal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  context     String[]
  dismissedAt DateTime @default(now())

  @@unique([userId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / DELETE / APPROVE / RESIGN / LOGIN ...
  entity    String
  entityId  String
  before    Json?
  after     Json?
  /// IP & user agent pelaku (bila aksi berasal dari request) — investigasi & rate limit login.
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action, ip, createdAt])
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String
  status    EmailStatus @default(QUEUED)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?
}

// Jejak reminder H-30 yang sudah dikirim (Tech Spec §7). Satu baris per item per tanggal
// berakhir, supaya reminder tidak terkirim dua kali dan tidak hilang bila worker sempat mati.
// Tanggal berakhir diubah (mis. sertifikat diperpanjang) → dueDate baru → reminder baru.
enum ReminderKind {
  CERTIFICATE
  DOCUMENT
  ASSET_SUPPORT
  ASSET_WARRANTY
}

model ReminderLog {
  id        String       @id @default(cuid())
  kind      ReminderKind
  entityId  String
  dueDate   DateTime     @db.Date
  createdAt DateTime     @default(now())

  @@unique([kind, entityId, dueDate])
}

// ---------------------------------------------------------------------
// ABSENSI (clock in / clock out) — keputusan user 2026-09-25
// ---------------------------------------------------------------------

// Satu baris per karyawan per hari kerja (tanggal Asia/Jakarta). Jam dari server saat klik.
// lateMinutes / earlyLeaveMinutes = snapshot terhadap jam kerja (AppSetting) saat dicatat;
// 0 di akhir pekan / hari libur. Koreksi Admin wajib alasan dan tercatat di audit.
model Attendance {
  id                String    @id @default(cuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  date              DateTime  @db.Date
  clockIn           DateTime
  clockOut          DateTime?
  lateMinutes       Int       @default(0)
  earlyLeaveMinutes Int       @default(0)
  /// Clock out diisi sistem di jam pulang (2026-10-30, job attendance.auto-clock-out). Karyawan yang lembur masih bisa
  /// clock out sendiri di hari yang sama (jam otomatis diganti jam sebenarnya).
  autoClockOut      Boolean   @default(false)
  correctedById     String?
  correctedBy       User?     @relation("AttendanceCorrector", fields: [correctedById], references: [id])
  correctedAt       DateTime?
  correctionNote    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// Overtime engineer (2026-10-30): terpisah dari absensi, boleh beberapa sesi per hari. Clock out sekaligus finalize
// (customer + project + pekerjaan) dan mengajukan approval modul OVERTIME (Ko Yosep, nomor OVT/…). Sesi APPROVED bisa
// dipilih di Reimburse Overtime (tipe OVERTIME, approval Ci Ika yang mengisi nominalnya). Satu sesi berjalan per
// karyawan (indeks unik parsial di migrasi).
model Overtime {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  date       DateTime  @db.Date // tanggal clock in (WIB)
  clockIn    DateTime
  clockOut   DateTime? // null = masih berjalan
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  activity   String? // pekerjaan yang dilakukan, diisi saat finalize
  number     String?       @unique // OVT/YYYY/MM/NNNN, dibuat saat finalize
  status     RequestStatus @default(DRAFT) // DRAFT = masih berjalan; PENDING/APPROVED/REJECTED = approval
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reimbursementItem ReimbursementItem?

  @@index([employeeId, date])
}

// Koreksi approver sebelum menyetujui (Fase 14, 2026-10-02): nominal & keterangan per baris.
// Satu baris per field yang berubah; terlihat oleh pemohon.
model ApprovalCorrection {
  id         String          @id @default(cuid())
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level      Int
  targetId   String // id ReimbursementItem / ProjectExpense / HealthClaim
  label      String // mis. "Baris 2 · 12 Sep · Tol Cikampek"
  field      String // AMOUNT | TEXT
  before     String
  after      String
  editedById String
  editedBy   User            @relation("CorrectionEditor", fields: [editedById], references: [id])
  createdAt  DateTime        @default(now())

  @@index([requestId])
}

// Daftar aset sederhana per karyawan (Fase 14, 2026-10-05) — dicatat Admin, terlihat di profil.
// Bukan modul Inventory (yang masih ditunda).
model EmployeeAsset {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  name         String
  serialNo     String?
  receivedDate DateTime  @db.Date
  returnedDate DateTime? @db.Date
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete (NFR v1.14)

  @@index([employeeId])
}

// Appeal untuk satu hari tidak hadir (tidak bisa clock in) — Fase 14. Approval Bu Ika; setelah
// disetujui status hari itu menjadi Sakit / Kunjungan keluar. Maks 7 hari sejak tanggal tsb.
model AttendanceAppeal {
  id         String        @id @default(cuid())
  number     String        @unique // APL/YYYY/MM/NNNN
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  date       DateTime      @db.Date // tanggal mulai
  /// Tanggal akhir bila appeal beberapa hari berturut-turut (2026-10-14); null = satu hari.
  endDate    DateTime?     @db.Date
  reason     AppealReason
  note       String
  /// Bukti surat keterangan sakit (opsional, PDF, 2026-10-14) — bisa dibuka approver.
  fileKey    String?
  fileName   String?
  status     RequestStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([employeeId, date])
}

// Divisi pekerjaan (2026-10-12: master data, bisa ditambah Admin di Setting → Divisi). `code` dipakai
// sebagai kunci di Employee.division, Reimbursement.division, ApprovalFlow.division, ReimburseType.divisions.
model Division {
  code        String   @id // mis. SALES, ENGINEER, UMUM, DIRECTOR, HR, FINANCE
  name        String   @unique
  /// Divisi tanpa alur approval sendiri memakai alur divisi ini (default UMUM).
  followsCode String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

