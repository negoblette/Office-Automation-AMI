# Database (hardening Tahap 4): aplikasi & worker memakai role oa_app (baca/tulis isi tabel saja);
# migrasi, seed, & Prisma Studio memakai role pemilik lewat MIGRATE_DATABASE_URL (prisma.config.ts).
# Role oa_app dibuat docker-compose.yml untuk volume baru; volume lama: `docker compose up -d` lalu `npm run db:roles`.
DATABASE_URL="postgresql://oa_app:oa_app_password@localhost:5432/office_automation?schema=public"
MIGRATE_DATABASE_URL="postgresql://oa:oa_password@localhost:5432/office_automation?schema=public"

# Enkripsi data pribadi (hardening Tahap 4) — isi dengan hasil `npm run keys:generate` (KUNCI KHUSUS DEV, beda dari
# produksi), lalu jalankan `npm run data:encrypt` untuk data lama. Data karyawan asli dilarang dipakai di dev;
# untuk data contoh pakai `npm run dev:data-palsu`.
DATA_ENCRYPTION_KEYS="v1:ganti-dengan-hasil-keys-generate"
DATA_INDEX_KEY="ganti-dengan-hasil-keys-generate"

# Kunci pemulihan (Setting → Kunci Pemulihan, docs/08-INVENTARIS-DATA.md §4): email pemegang kunci, pisahkan koma.
# Dev: akun seed Rudy & Leonard. File kunci disimpan di RECOVERY_DIR (sudah di-.gitignore lewat /storage/).
RECOVERY_KEY_HOLDERS="rudy@artha-mitra.local,leonard@artha-mitra.local"
RECOVERY_DIR="./storage/recovery"

# Auth.js (generate: npx auth secret)
AUTH_SECRET="ganti-dengan-secret-acak"
# AUTH_URL sengaja tidak diisi saat development (2026-10-15): bila diisi "http://localhost:3000",
# login lewat IP (mis. http://10.192.113.5:3000) dialihkan ke localhost dan gagal. Isi hanya di production.
# AUTH_URL="http://localhost:3000"

# Email (dev: Mailpit dari docker compose)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Office Automation <no-reply@artha-mitra.local>"

# File storage
STORAGE_DRIVER="local"          # local | s3
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="5"

# App
APP_URL="http://localhost:3000"
TZ="Asia/Jakarta"

# Seed (npx prisma db seed) — password awal semua user contoh (khusus dev), min. 8 karakter.
# Produksi: isi juga SEED_MUST_CHANGE_PASSWORD="true" (lihat .env.production.example).
SEED_PASSWORD="ganti-password-seed"

# Database khusus test (npm test) — dibuat ulang setiap test DB dijalankan, JANGAN pakai DB dev
TEST_DATABASE_URL="postgresql://oa:oa_password@localhost:5432/office_automation_test?schema=public"
