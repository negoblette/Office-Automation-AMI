{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx worker/index.ts",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --jsx=automatic --tsconfig=tsconfig.json --outfile=dist/worker.mjs",
    "postinstall": "prisma generate",
    "keys:generate": "node scripts/keys-generate.mjs",
    "data:encrypt": "tsx scripts/data-encrypt.ts",
    "data:lihat": "tsx scripts/data-view.ts",
    "data:cari-nik": "tsx scripts/data-find-nik.ts",
    "recovery:refresh": "tsx scripts/recovery-refresh.ts",
    "dev:data-palsu": "tsx scripts/dev-fake-data.ts",
    "db:roles": "docker compose exec -T db bash /docker-entrypoint-initdb.d/10-roles.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.2.4",
    "age-encryption": "^0.3.1",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.1.7",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "argon2": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
